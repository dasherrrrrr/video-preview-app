# Kopieren nach .env und Werte für den jeweiligen Server anpassen.
# .env wird von docker-compose.yml über ${VAR}-Platzhalter eingelesen und
# ist bewusst NICHT in Git (siehe .gitignore) - so bleiben server-spezifische
# Secrets und Pfade bei "git pull" unangetastet.

# Host-Port, auf dem die App erreichbar ist (Standard 8000, falls belegt anpassen)
HOST_PORT=8000

# Pfad auf dem Host, unter dem die Videodateien liegen (read-only gemountet)
VIDEOS_HOST_PATH=/mnt/user/videos

# Erzeugen mit: openssl rand -hex 32
SESSION_SECRET=bitte-hier-einen-zufaelligen-wert-eintragen

# GPU-Node für VAAPI-Transcoding (HEVC/H.265 -> H.264). Mit "ls /dev/dri" auf
# dem Host prüfen, welcher renderDXXX-Node zur gewünschten GPU gehört, falls
# mehrere GPUs im System stecken.
VAAPI_DEVICE=/dev/dri/renderD128

# SMTP-Zugang für Mailbenachrichtigungen (z.B. bei neuen Kunden-Kommentaren an
# den zugewiesenen Bearbeiter). Funktioniert mit jedem SMTP-Anbieter - hier
# Beispielwerte für die gängigsten:
#
#   Gmail:  SMTP_HOST=smtp.gmail.com   SMTP_PORT=587  SMTP_USE_SSL=false
#           (braucht ein "App-Passwort", nicht das normale Google-Passwort)
#   web.de: SMTP_HOST=smtp.web.de     SMTP_PORT=587  SMTP_USE_SSL=false
#   GMX:    SMTP_HOST=mail.gmx.net    SMTP_PORT=587  SMTP_USE_SSL=false
#
# Leer lassen (SMTP_HOST leer), um Mailversand komplett zu deaktivieren - die
# App funktioniert dann normal weiter, es werden nur keine Mails verschickt.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Absenderadresse - falls leer, wird SMTP_USERNAME verwendet
SMTP_FROM=
# "true" nur setzen, wenn der Anbieter direktes SSL statt STARTTLS verlangt
# (meist Port 465)
SMTP_USE_SSL=false

# Öffentliche URL der App (ohne trailing slash), für Links in Mails - z.B.
# http://192.168.178.250:8001 oder eine eigene Domain
APP_BASE_URL=

# Weiterleitung von Monitoring-Alarmen (z.B. Unraid Apprise-Agent, TrueNAS
# Alert-Service) über POST /api/admin/incidents an Concordes IT-Vorfälle.
# Leer lassen, um diese Weiterleitung zu deaktivieren (Endpoint antwortet
# dann mit 500).
SUPABASE_URL=
SUPABASE_ANON_KEY=
INCIDENT_INGEST_TOKEN=
